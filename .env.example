# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Payment Gateway (Razorpay)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Print-on-Demand Fulfillment (Qikink API v2)
QIKINK_CLIENT_ID=your_client_id
QIKINK_CLIENT_SECRET=your_client_secret
QIKINK_API_KEY=your_api_key
QIKINK_API_SECRET=your_api_secret
QIKINK_ENV=sandbox
QIKINK_BASE_URL=https://sandbox.qikink.com/api/v2
QIKINK_WEBHOOK_SECRET=your_webhook_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional Email Engine (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=RIIQX <orders@riiqx.com>
