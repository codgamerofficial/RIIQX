{
  "expo": {
    "name": "RIIQX",
    "slug": "riiqx-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "riiqx",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050508"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.riiqx.app",
      "infoPlist": {
        "NSCameraUsageDescription": "RIIQX needs camera access to scan NFC serial tags on physical technical apparel.",
        "NSFaceIDUsageDescription": "RIIQX uses FaceID for instant biometric checkout authentication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050508"
      },
      "package": "com.riiqx.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
